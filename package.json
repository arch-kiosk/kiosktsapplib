{
  "name": "kiosktsapplib",
  "description": "Library for Kiosk Typescript Apps",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "dist/kiosktsapplib.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/kiosktsapplib.js"
      }
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "keywords": [],
  "author": "Lutz Klein",
  "license": "AGPL-3.0",
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": false,
    "printWidth": 120,
    "tabWidth": 4
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "dist": "tsc && vite build && npm pack --pack-destination ./dist",
    "test": "vitest --mode development"
  },
  "peerDependencies": {
    "@lit/context": "^1.1.6",
    "dexie": "^4.2.0",
    "lit": "^3.3.1",
    "luxon": "^3.7.1",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/luxon": "^3.4.2",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.4.2",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.77.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^3.2.4"
  }
}
